// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bet {
  id           String   @id @default(cuid())
  instagram    String   @unique
  brazilScore  Int
  moroccoScore Int
  scorers      String[]
  createdAt    DateTime @default(now())
}

model MatchConfig {
  id               String   @id @default("brazil-morocco")
  bettingOpen      Boolean  @default(true)
  realBrazilScore  Int?
  realMoroccoScore Int?
  realScorers      String[]
}
