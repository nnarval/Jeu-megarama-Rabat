generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bet {
  id          String   @id @default(cuid())
  matchId     String
  instagram   String
  team1Score  Int
  team2Score  Int
  scorers     String[]
  createdAt   DateTime @default(now())

  @@unique([matchId, instagram])
}

model MatchConfig {
  id             String   @id
  bettingOpen    Boolean  @default(true)
  realTeam1Score Int?
  realTeam2Score Int?
  realScorers    String[]
}
